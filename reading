<div id="particles-container" class="fixed inset-0 pointer-events-none z-0"></div>

<nav class="fixed top-0 right-0 left-0 z-50 glass-card border-b border-blue-100">
  <div class="container mx-auto px-6 py-3 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-full bg-gradient-to-br from-blue-600 to-blue-800 flex items-center justify-center border border-blue-200"><i class="fas fa-book-open text-white"></i></div>
      <div><h1 class="font-display font-bold text-base blue-text">روّاد الغد</h1><p class="text-xs text-slate-500">مسابقة تحدي القراءة</p></div>
    </div>
    <div class="hidden lg:flex items-center gap-8">
      <a href="#home" class="nav-link">الرئيسية</a><a href="#stages" class="nav-link">المراحل</a><a href="#rules" class="nav-link">شروط المسابقة</a><a href="#stats" class="nav-link">الإحصائيات</a>
