const Store = {
  async getStudents() {
    if (useSupabase) {
      const { data, error } = await supabaseClient.from('students').select('*');
      if (error) { console.error("Supabase Error (getStudents):", error); throw error; }
      return data;
    }
    return JSON.parse(localStorage.getItem(STORAGE_KEYS.STUDENTS) || '[]');
  },
  async addStudent(student) {
    if (useSupabase) {
      const { data, error } = await supabaseClient.from('students').insert([student]).select();
      if (error) { console.error("Supabase Error (addStudent):", error); throw error; }
      return data[0];
    }
    const students = await this.getStudents(); students.push(student);
    localStorage.setItem(STORAGE_KEYS.STUDENTS, JSON.stringify(students)); return student;
  },
  async deleteStudent(id) {
    if (useSupabase) {
      const { error } = await supabaseClient.from('students').delete().eq('id', id);
      if (error) { console.error("Supabase Error (deleteStudent):", error); throw error; }
    } else {
      const students = await this.getStudents();
      localStorage.setItem(STORAGE_KEYS.STUDENTS, JSON.stringify(students.filter(s => s.id !== id)));
    }
  },
  async getBooks() {
    if (useSupabase) {
      const { data, error } = await supabaseClient.from('books').select('*');
