<style>
:root {
  --bg-primary: #f8fafc;
  --bg-secondary: #ffffff;
  --bg-tertiary: #eff6ff;
  --blue-deep: #1e3a8a;
  --blue-primary: #2563eb;
  --blue-light: #60a5fa;
  --blue-accent: #3b82f6;
  --text-main: #1e293b;
  --text-muted: #64748b;
  --border-color: #dbeafe;
  --success: #16a34a;
  --danger: #dc2626;
}
* { font-family: 'Tajawal', sans-serif; }
body { background: var(--bg-primary); color: var(--text-main); overflow-x: hidden; }
.font-display { font-family: 'Reem Kufi', sans-serif; }
.glass-card { background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(59, 130, 246, 0.1); box-shadow: 0 4px 20px rgba(30, 58, 138, 0.05); }
.blue-text { color: var(--blue-primary); }
.btn-primary { background: linear-gradient(135deg, var(--blue-primary) 0%, var(--blue-accent) 100%); color: #ffffff; font-weight: 700; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3); }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(37, 99, 235, 0.4); }
.btn-outline { background: transparent; border: 1px solid var(--blue-primary); color: var(--blue-primary); font-weight: 700; transition: all 0.3s ease; }
.btn-outline:hover { background: var(--blue-primary); color: #ffffff; transform: translateY(-2px); }
@keyframes shimmer { 0% { background-position: -200% center; } 100% { background-position: 200% center; } }
.shimmer-text { background: linear-gradient(90deg, var(--blue-deep) 0%, var(--blue-light) 25%, var(--blue-primary) 50%, var(--blue-light) 75%, var(--blue-deep) 100%); background-size: 200% auto; background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shimmer 4s linear infinite; }
.stage-card { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); position: relative; overflow: hidden; }
.stage-card::before { content: ''; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.1), transparent); transition: left 0.6s ease; }
.stage-card:hover::before { left: 100%; }
.stage-card:hover { transform: translateY(-8px); border-color: var(--blue-primary); box-shadow: 0 20px 40px rgba(30, 58, 138, 0.1), 0 0 30px rgba(59, 130, 246, 0.1); }
.input-field { background: #ffffff; border: 1px solid #e2e8f0; color: var(--text-main); transition: all 0.3s ease; }
.input-field:focus { outline: none; border-color: var(--blue-primary); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
.input-field::placeholder { color: #94a3b8; }
@keyframes floatBook { 0% { transform: translateY(100vh) rotate(0deg); opacity: 0; } 10% { opacity: 0.05; } 90% { opacity: 0.05; } 100% { transform: translateY(-100px) rotate(360deg); opacity: 0; } }
.floating-book { position: absolute; color: var(--blue-primary); font-size: 24px; animation: floatBook 18s linear infinite; pointer-events: none; }
html { scroll-behavior: smooth; }
::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { background: var(--bg-tertiary); }
::-webkit-scrollbar-thumb { background: var(--blue-light); border-radius: 5px; }
::-webkit-scrollbar-thumb:hover { background: var(--blue-primary); }
.modal-backdrop { background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(8px); }
.toast { position: fixed; bottom: 30px; right: 30px; z-index: 9999; transform: translateY(100px); opacity: 0; transition: all 0.4s ease; }
.toast.show { transform: translateY(0); opacity: 1; }
.divider-ornament { display: flex; align-items: center; justify-content: center; margin: 3rem 0; }
.divider-ornament::before, .divider-ornament::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to left, transparent, var(--blue-light), transparent); max-width: 200px; }
.divider-ornament span { color: var(--blue-primary); margin: 0 20px; font-size: 1.5rem; }
.progress-fill { background: linear-gradient(90deg, var(--blue-deep) 0%, var(--blue-primary) 50%, var(--blue-light) 100%); box-shadow: 0 0 15px rgba(59, 130, 246, 0.3); transition: width 1s ease-out; }
.nav-link { position: relative; color: var(--text-muted); font-weight: 500; transition: color 0.3s ease; }
.nav-link::after { content: ''; position: absolute; bottom: -4px; right: 0; width: 0; height: 2px; background: var(--blue-primary); transition: width 0.3s ease; }
.nav-link:hover { color: var(--blue-primary); }
.nav-link:hover::after { width: 100%; }
.hero-glow { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.2; pointer-events: none; }
.category-pill { background: #eff6ff; border: 1px solid #dbeafe; color: var(--blue-primary); }
.tab-btn { color: var(--text-muted); border-bottom: 2px solid transparent; transition: all 0.3s ease; }
.tab-btn:hover { color: var(--blue-primary); }
.tab-btn.active { color: var(--blue-primary); border-bottom-color: var(--blue-primary); }
.role-tab { padding: 10px; border-bottom: 2px solid transparent; cursor: pointer; font-weight: 700; color: var(--text-muted); transition: all 0.3s; }
.role-tab.active { color: var(--blue-primary); border-bottom-color: var(--blue-primary); }
@media (max-width: 768px) { .hero-title { font-size: 2.5rem !important; } }
</style>
</head>
