<section id="stats" class="py-20 relative">
  <div class="container mx-auto px-6">
    <div class="text-center mb-12"><span class="category-pill px-4 py-1.5 rounded-full text-sm"><i class="fas fa-chart-line ml-2"></i>التحليلات</span><h2 class="font-display font-bold text-4xl md:text-5xl mt-4 mb-3 blue-text">إحصائيات المدرسة</h2></div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      <div class="glass-card rounded-2xl p-6 text-center"><i class="fas fa-users text-3xl blue-text mb-3"></i><div class="text-4xl font-bold blue-text" id="statStudents">0</div><div class="text-sm text-slate-500 mt-2">طالب مشارك</div></div>
      <div class="glass-card rounded-2xl p-6 text-center"><i class="fas fa-book text-3xl blue-text mb-3"></i><div class="text-4xl font-bold blue-text" id="statBooks">0</div><div class="text-sm text-slate-500 mt-2">كتاب مقروء</div></div>
      <div class="glass-card rounded-2xl p-6 text-center"><i class="fas fa-file-alt text-3xl blue-text mb-3"></i><div class="text-4xl font-bold blue-text" id="statPages">0</div><div class="text-sm text-slate-500 mt-2">صفحة مقروءة</div></div>
      <div class="glass-card rounded-2xl p-6 text-center"><i class="fas fa-medal text-3xl blue-text mb-3"></i><div class="text-4xl font-bold blue-text" id="statCompleted">0</div><div class="text-sm text-slate-500 mt-2">طالب أكمل التحدي</div></div>
