  const name = document.getElementById('regName').value.trim(); const grade = parseInt(document.getElementById('regGrade').value);
  const className = document.getElementById('regClass').value.trim() || '-'; const password = document.getElementById('regPassword').value.trim();
  if (!name || !password) { errEl.textContent = 'يرجى تعبئة الاسم وكلمة السر'; errEl.classList.remove('hidden'); return; }
  let stage; if (grade >= 1 && grade <= 3) stage = 'national'; else if (grade >= 4 && grade <= 6) stage = 'arab1'; else stage = 'arab2';
  let newId = 'rw' + Math.floor(1000 + Math.random() * 9000); while (allStudents.find(s => s.id === newId)) { newId = 'rw' + Math.floor(1000 + Math.random() * 9000); }
  const newStudent = { id: newId, name, grade, class: className, stage, password };
  try { await Store.addStudent(newStudent); allStudents = await Store.getStudents(); closeLoginModal(); currentStudent = newStudent; openStudentDashboard(); showToast('success', 'تم إنشاء الحساب', `رمز الدخول الخاص بك هو: ${newId} (احفظه جيداً)`); renderStats(); document.getElementById('regName').value = ''; document.getElementById('regClass').value = ''; document.getElementById('regPassword').value = ''; errEl.classList.add('hidden'); } 
  catch (error) { errEl.textContent = 'حدث خطأ أثناء التسجيل: ' + error.message; errEl.classList.remove('hidden'); }
}

function handleLogin(e) {
  e.preventDefault(); const errEl = document.getElementById('loginError');
  if (currentLoginRole === 'teacher') { const username = document.getElementById('loginUsername').value.trim(); const password = document.getElementById('loginPassword').value; const admin = ADMINS.find(a => a.username === username && a.password === password); if (admin) { currentTeacher = admin; closeLoginModal(); openTeacherDashboard(); showToast('success', 'تم الدخول', `مرحباً ${admin.name}`); } else { errEl.textContent = 'بيانات المعلم غير صحيحة'; errEl.classList.remove('hidden'); } } 
  else { const sid = document.getElementById('loginStudentId').value.trim(); const pass = document.getElementById('loginStudentPass').value; const student = allStudents.find(s => s.id.toLowerCase() === sid.toLowerCase() && s.password === pass); if (student) { currentStudent = student; closeLoginModal(); openStudentDashboard(); showToast('success', 'تم الدخول', `أهلاً ${student.name}`); } else { errEl.textContent = 'رمز الطالب أو كلمة السر غير صحيحة'; errEl.classList.remove('hidden'); } }
}
function logout() { currentTeacher = null; currentStudent = null; document.getElementById('teacherDashboard').classList.add('hidden'); document.getElementById('studentDashboard').classList.add('hidden'); showToast('info', 'تم الخروج', 'إلى اللقاء'); }
function togglePassword(inputId, btn) { const input = document.getElementById(inputId); if (input.type === 'password') { input.type = 'text'; btn.innerHTML = '<i class="fas fa-eye-slash"></i>'; } else { input.type = 'password'; btn.innerHTML = '<i class="fas fa-eye"></i>'; } }

function openStudentDashboard() { document.getElementById('studentDashboard').classList.remove('hidden'); document.getElementById('studentNameDisplay').textContent = `${currentStudent.name} (رمزك: ${currentStudent.id})`; renderStudentProgress(); renderStudentBooks(); switchStudentTab('addBook'); }
function switchStudentTab(tabName) { document.querySelectorAll('#studentDashboard .tab-btn').forEach(b => b.classList.remove('active')); document.getElementById('stu-tab-' + tabName).classList.add('active'); document.querySelectorAll('#studentDashboard .tab-content').forEach(c => c.classList.add('hidden')); document.getElementById('stu-content-' + tabName).classList.remove('hidden'); }
function renderStudentProgress() { const books = allBooks.filter(b => b.studentId === currentStudent.id); const stage = STAGES_CONFIG[currentStudent.stage]; const count = books.length; const pages = books.reduce((s, b) => s + b.pages, 0); const cats = new Set(books.map(b => b.category)).size; const progress = Math.min(100, (count / stage.target) * 100); document.getElementById('studentBooksCount').textContent = `${count} / ${stage.target}`; document.getElementById('studentPagesCount').textContent = pages; document.getElementById('studentCategoriesCount').textContent = cats; document.getElementById('studentProgressBar').style.width = progress + '%'; document.getElementById('studentProgressCircle').textContent = Math.round(progress) + '%'; }
function renderStudentBooks() { const tbody = document.getElementById('studentBooksTableBody'); const books = allBooks.filter(b => b.studentId === currentStudent.id); tbody.innerHTML = ''; if (books.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-slate-400">لم تسجل أي كتاب بعد.</td></tr>'; return; } books.forEach(b => { const row = document.createElement('tr'); row.className = 'border-b border-slate-100 hover:bg-blue-50/50 transition'; row.innerHTML = `<td class="py-3 px-2 font-medium text-slate-800">${b.title}</td><td class="py-3 px-2 text-slate-500">${b.author || '---'}</td><td class="py-3 px-2 blue-text font-bold">${b.pages}</td><td class="py-3 px-2"><span class="category-pill px-2 py-1 rounded text-xs">${b.category}</span></td><td class="py-3 px-2"><button onclick="deleteStudentBook('${b.id}')" class="text-red-500 hover:text-red-700 text-sm"><i class="fas fa-trash"></i></button></td>`; tbody.appendChild(row); }); }
document.addEventListener('change', e => { if (e.target.id === 'stuBookPages') validateStudentBook(); });
function validateStudentBook() { const pages = parseInt(document.getElementById('stuBookPages').value); const msgEl = document.getElementById('stuBookValidationMsg'); if (!pages) { msgEl.classList.add('hidden'); return; } const stage = STAGES_CONFIG[currentStudent.stage]; if (pages < stage.minPages) { msgEl.className = 'text-sm rounded-lg p-3 bg-yellow-50 border border-yellow-200 text-yellow-700'; msgEl.innerHTML = `<i class="fas fa-exclamation-triangle ml-2"></i>عدد الصفحات أقل من الحد الأدنى لمرحلتك (${stage.minPages} صفحة).`; } else if (pages > stage.maxPages) { msgEl.className = 'text-sm rounded-lg p-3 bg-green-50 border border-green-200 text-green-700'; msgEl.innerHTML = `<i class="fas fa-info-circle ml-2"></i>عدد الصفحات يتجاوز الحد الأعلى. الصفحات الإضافية تحتسب ككتاب إضافي.`; } else { msgEl.className = 'text-sm rounded-lg p-3 bg-green-50 border border-green-200 text-green-700'; msgEl.innerHTML = `<i class="fas fa-check-circle ml-2"></i>عدد الصفحات ضمن النطاق المطلوب.`; } msgEl.classList.remove('hidden'); }
async function handleStudentAddBook(e) {
  e.preventDefault();
  const title = document.getElementById('stuBookTitle').value.trim();
  const author = document.getElementById('stuBookAuthor').value.trim();
  const pages = parseInt(document.getElementById('stuBookPages').value);
  const category = document.getElementById('stuBookCategory').value;
  const book = { studentId: currentStudent.id, title, author: author || 'غير محدد', pages, category, date: new Date().toISOString().split('T')[0], stage: currentStudent.stage };
  try {
    await Store.addBook(book);
    allBooks = await Store.getBooks();
    document.getElementById('stuBookTitle').value = '';
    document.getElementById('stuBookAuthor').value = '';
    document.getElementById('stuBookPages').value = '';
    document.getElementById('stuBookCategory').value = '';
    document.getElementById('stuBookValidationMsg').classList.add('hidden');
    showToast('success', 'تم الحفظ', `تم تسجيل كتاب "${title}"`);
    renderStudentProgress();
    renderStudentBooks();
    renderStats();
  } catch (error) {
    console.error("Error adding book:", error);
    showToast('error', 'خطأ في الحفظ', `تعذر حفظ الكتاب: ${error.message}`);
  }
}
async function deleteStudentBook(id) { if (!confirm('هل أنت متأكد من حذف هذا الكتاب من قائمتك؟')) return; try { await Store.deleteBook(id); allBooks = await Store.getBooks(); renderStudentProgress(); renderStudentBooks(); renderStats(); showToast('success', 'تم الحذف', 'تم حذف الكتاب.'); } catch (error) { showToast('error', 'خطأ', 'تعذر الحذف.'); } }

function openTeacherDashboard() { document.getElementById('teacherDashboard').classList.remove('hidden'); document.getElementById('teacherNameDisplay').textContent = currentTeacher.name; renderStudentsTable(); renderRecords(); renderReports(); switchTab('students'); }
function closeDashboard() { document.getElementById('teacherDashboard').classList.add('hidden'); }
function switchTab(tabName) { document.querySelectorAll('#teacherDashboard .tab-btn').forEach(b => b.classList.remove('active')); document.getElementById('tab-' + tabName).classList.add('active'); document.querySelectorAll('#teacherDashboard .tab-content').forEach(c => c.classList.add('hidden')); document.getElementById('content-' + tabName).classList.remove('hidden'); }
async function deleteStudent(id) { if (!confirm('هل أنت متأكد من حذف هذا الطالب؟ سيتم حذف جميع كتبه.')) return; try { await Store.deleteStudent(id); const sBooks = allBooks.filter(b => b.studentId === id); for (const b of sBooks) { await Store.deleteBook(b.id); } allStudents = await Store.getStudents(); allBooks = await Store.getBooks(); renderStudentsTable(); renderRecords(); renderStats(); showToast('success', 'تم الحذف', 'تم حذف الطالب.'); } catch (error) { showToast('error', 'خطأ', 'تعذر الحذف.'); } }
function renderStudentsTable() { const tbody = document.getElementById('studentsTableBody'); const filterStage = document.getElementById('filterStudentStage')?.value || 'all'; const sortBy = document.getElementById('sortStudentsBy')?.value || 'default'; let displayStudents = [...allStudents]; if (filterStage !== 'all') { displayStudents = displayStudents.filter(s => s.stage === filterStage); } let studentsWithStats = displayStudents.map(s => { const stage = STAGES_CONFIG[s.stage]; const books = allBooks.filter(b => b.studentId === s.id); const totalPages = books.reduce((sum, b) => sum + b.pages, 0); const progress = Math.min(100, (books.length / stage.target) * 100); return { ...s, bookCount: books.length, totalPages, progress, stageName: stage.name, target: stage.target }; }); if (sortBy === 'books_desc') { studentsWithStats.sort((a, b) => b.bookCount - a.bookCount || b.totalPages - a.totalPages); } else if (sortBy === 'pages_desc') { studentsWithStats.sort((a, b) => b.totalPages - a.totalPages); } else if (sortBy === 'progress_desc') { studentsWithStats.sort((a, b) => b.progress - a.progress); } else if (sortBy === 'name_asc') { studentsWithStats.sort((a, b) => a.name.localeCompare(b.name, 'ar')); } else if (sortBy === 'grade_asc') { studentsWithStats.sort((a, b) => a.grade - b.grade); } tbody.innerHTML = ''; if (studentsWithStats.length === 0) { tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-slate-400">لا يوجد طلاب مطابقون للبحث.</td></tr>'; return; } studentsWithStats.forEach(s => { const row = document.createElement('tr'); row.className = 'border-b border-slate-100 hover:bg-blue-50/50 transition'; row.innerHTML = `<td class="py-3 px-2 font-medium text-slate-800">${s.name}</td><td class="py-3 px-2 text-slate-600">الصف ${s.grade}</td><td class="py-3 px-2 blue-text font-mono text-xs">${s.id}</td><td class="py-3 px-2 text-slate-600 text-xs">${s.password}</td><td class="py-3 px-2"><div class="flex items-center gap-2"><div class="flex-1 min-w-[100px]"><div class="flex justify-between text-xs mb-1"><span class="blue-text font-bold">${s.bookCount}/${s.target}</span><span class="text-slate-400">${Math.round(s.progress)}%</span></div><div class="h-2 bg-slate-100 rounded-full overflow-hidden"><div class="progress-fill h-full rounded-full" style="width: ${s.progress}%"></div></div></div></div></td><td class="py-3 px-2"><button onclick="deleteStudent('${s.id}')" class="text-red-500 hover:text-red-700 text-sm"><i class="fas fa-trash"></i></button></td>`; tbody.appendChild(row); }); }
function renderRecords() { const tbody = document.getElementById('recordsTableBody'); const search = (document.getElementById('searchRecords')?.value || '').toLowerCase(); const filterStage = document.getElementById('filterRecordsStage')?.value || 'all'; tbody.innerHTML = ''; let filtered = allBooks; if (filterStage !== 'all') { filtered = filtered.filter(b => b.stage === filterStage); } if (search) { filtered = filtered.filter(b => { const s = allStudents.find(st => st.id === b.studentId); return b.title.toLowerCase().includes(search) || (s && s.name.toLowerCase().includes(search)); }); } if (filtered.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="text-center py-8 text-slate-400">لا توجد سجلات.</td></tr>'; return; } filtered.forEach(b => { const s = allStudents.find(st => st.id === b.studentId); const row = document.createElement('tr'); row.className = 'border-b border-slate-100 hover:bg-blue-50/50 transition'; row.innerHTML = `<td class="py-3 px-2 font-medium text-slate-800">${s ? s.name : '---'}</td><td class="py-3 px-2 text-slate-700">${b.title}</td><td class="py-3 px-2 blue-text font-bold">${b.pages}</td><td class="py-3 px-2"><span class="category-pill px-2 py-1 rounded text-xs">${b.category}</span></td><td class="py-3 px-2"><button onclick="deleteBook('${b.id}')" class="text-red-500 hover:text-red-700 text-sm"><i class="fas fa-trash"></i></button></td>`; tbody.appendChild(row); }); }
async function deleteBook(id) { if (!confirm('هل أنت متأكد من حذف هذا الكتاب؟')) return; try { await Store.deleteBook(id); allBooks = await Store.getBooks(); renderRecords(); renderStudentsTable(); renderStats(); showToast('success', 'تم الحذف', 'تم حذف الكتاب.'); } catch (error) { showToast('error', 'خطأ', 'تعذر الحذف.'); } }
function renderReports() { const stage = document.getElementById('reportStage')?.value || 'national'; const list = document.getElementById('topStudentsList'); const stageStudents = allStudents.filter(s => s.stage === stage).map(s => { const books = allBooks.filter(b => b.studentId === s.id); return { ...s, bookCount: books.length, totalPages: books.reduce((sum, b) => sum + b.pages, 0) }; }); stageStudents.sort((a, b) => b.bookCount - a.bookCount || b.totalPages - a.totalPages); const top10 = stageStudents.slice(0, 10); if (top10.length === 0) { list.innerHTML = '<p class="text-slate-400 text-center py-4">لا يوجد طلاب.</p>'; return; } list.innerHTML = top10.map((s, idx) => { const rank = idx + 1; const rankClass = rank === 1 ? 'text-yellow-500' : rank === 2 ? 'text-slate-400' : rank === 3 ? 'text-orange-400' : 'text-slate-400'; return `<div class="flex items-center gap-3 p-3 bg-blue-50 rounded-lg border border-blue-100"><div class="w-8 h-8 rounded-full bg-white flex items-center justify-center font-bold ${rankClass}">${rank}</div><div class="flex-1"><div class="font-bold text-sm text-slate-800">${s.name}</div><div class="text-xs text-slate-500">الصف ${s.grade}</div></div><div class="text-left"><div class="blue-text font-bold">${s.bookCount} كتاب</div><div class="text-xs text-slate-500">${s.totalPages} صفحة</div></div></div>`; }).join(''); }
function exportReport() { const stage = document.getElementById('reportStage').value; const stageName = STAGES_CONFIG[stage].name; const stageStudents = allStudents.filter(s => s.stage === stage).map(s => { const books = allBooks.filter(b => b.studentId === s.id); return { name: s.name, grade: s.grade, bookCount: books.length, totalPages: books.reduce((sum, b) => sum + b.pages, 0) }; }); stageStudents.sort((a, b) => b.bookCount - a.bookCount); let csv = `\uFEFFترتيب,اسم الطالب,الصف,عدد الكتب,إجمالي الصفحات\n`; stageStudents.forEach((s, idx) => { csv += `${idx + 1},${s.name},${s.grade},${s.bookCount},${s.totalPages}\n`; }); const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `تقرير_${stageName}.csv`; link.click(); showToast('success', 'تم التصدير', 'تم تصدير التقرير.'); }

function showToast(type, title, msg) { const toast = document.getElementById('toast'); const icon = document.getElementById('toastIcon'); document.getElementById('toastTitle').textContent = title; document.getElementById('toastMsg').textContent = msg; if (type === 'success') icon.className = 'fas fa-check-circle text-2xl text-green-500'; else if (type === 'error') icon.className = 'fas fa-exclamation-circle text-2xl text-red-500'; else icon.className = 'fas fa-info-circle text-2xl text-blue-500'; toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 4000); }
document.getElementById('loginModal').addEventListener('click', e => { if (e.target.id === 'loginModal') closeLoginModal(); });
init();
</script>

